{
  "name": "@sales-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file ../.env --env-file .env src/index.ts",
    "dev:compiled": "npm run build && npm run start",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file ../.env --env-file .env dist/index.js",
    "worker": "tsx watch --env-file ../.env --env-file .env src/workers/index.ts",
    "worker:compiled": "node --env-file ../.env --env-file .env dist/workers/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "npm run prisma:seed:build && node dist-prisma/seed.js",
    "prisma:seed:build": "tsc -p tsconfig.seed.json",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "npm run prisma:seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@prisma/client": "6.12.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jose": "^6.0.13",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "prisma": "6.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
