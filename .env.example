# Docker infrastructure. Replace every change-me value before first use.
POSTGRES_DB=sales_agent
POSTGRES_USER=sales_agent
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me-use-a-long-random-password
REDIS_PORT=6379
MINIO_ROOT_USER=salesagentadmin
MINIO_ROOT_PASSWORD=change-me-use-a-long-random-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Local Express API.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Public Express origin used by the static cPanel frontend, e.g. https://api.example.com
# Leave blank only when the same domain proxies /api to Express.
NEXT_PUBLIC_API_ORIGIN=
DATABASE_URL=postgresql://sales_agent:change-me-use-a-long-random-password@localhost:5432/sales_agent?schema=public
REDIS_URL=redis://:change-me-use-a-long-random-password@localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=salesagentadmin
MINIO_SECRET_KEY=change-me-use-a-long-random-password
MINIO_BUCKET=sales-agent-private

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-64-hex-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false
