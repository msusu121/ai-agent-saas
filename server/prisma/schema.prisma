generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum CredentialProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  GROQ
  OPENROUTER
  APOLLO
  GOOGLE_PLACES
  GOOGLE_CUSTOM_SEARCH
  SERPER
  BRAVE_SEARCH
  FIRECRAWL
  HUNTER
  CLEARBIT
  HUBSPOT
  META
  APIFY
  WHATSAPP
  RESEND
  SENDGRID
  SMTP
  CUSTOM
}

enum CampaignStatus {
  DRAFT
  QUEUED
  DISCOVERING
  QUALIFYING
  READY
  PAUSED
  COMPLETED
  FAILED
}

enum LeadStatus {
  DISCOVERED
  QUALIFIED
  CONTACTED
  REPLIED
  MEETING
  PROPOSAL
  WON
  LOST
  SUPPRESSED
}

enum OutreachStatus {
  DRAFT
  NEEDS_REVIEW
  SCHEDULED
  SENDING
  SENT
  DELIVERED
  OPENED
  REPLIED
  BOUNCED
  FAILED
  STOPPED
}

enum OutreachChannel {
  EMAIL
  WHATSAPP
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE
  CREDENTIAL_CREATE
  CREDENTIAL_ROTATE
  CREDENTIAL_DELETE
  OUTREACH_APPROVE
  OUTREACH_SEND
  AUTOPILOT_PAUSE
  AUTOPILOT_RESUME
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships  Membership[]
  sessions     RefreshSession[]
  auditLogs    AuditLog[]
}

model Organization {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  plan           String               @default("starter")
  timezone       String               @default("Africa/Nairobi")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  memberships    Membership[]
  credentials    ProviderCredential[]
  campaigns      Campaign[]
  products       Product[]
  leads          Lead[]
  contacts       Contact[]
  sequences      Sequence[]
  outreach       OutreachMessage[]
  autopilot      AutopilotConfig?
  files          FileObject[]
  auditLogs      AuditLog[]
  refreshSessions RefreshSession[]
  socialProducts SocialProduct[]
  socialAccounts SocialAccount[]
  socialPosts SocialPost[]
}

model SocialProduct {
  id String @id @default(cuid())
  organizationId String
  name String
  description String
  audience String
  claims String
  voice String
  website String
  callToAction String
  growthPlan Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts SocialPost[]
  @@index([organizationId])
}

model SocialAccount {
  id String @id @default(cuid())
  organizationId String
  platform String
  externalId String
  name String
  ciphertext String
  iv String
  authTag String
  keyVersion Int @default(1)
  active Boolean @default(true)
  checkedAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts SocialPost[]
  @@unique([organizationId, platform, externalId])
}

model SocialPost {
  id String @id @default(cuid())
  organizationId String
  productId String
  accountId String
  caption String
  imageUrl String?
  creativeBrief String @default("")
  rationale String @default("")
  evidence Json?
  status String @default("DRAFT")
  scheduledAt DateTime?
  approvedBy String?
  approvedAt DateTime?
  publishedAt DateTime?
  providerId String?
  permalink String?
  containerId String?
  failureReason String?
  metrics Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product SocialProduct @relation(fields: [productId], references: [id])
  account SocialAccount @relation(fields: [accountId], references: [id])
  @@index([organizationId, createdAt])
  @@index([status, scheduledAt])
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model RefreshSession {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  userId         String
  organizationId String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  userAgent      String?
  ipHash         String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ProviderCredential {
  id             String             @id @default(cuid())
  organizationId String
  provider       CredentialProvider
  label          String
  ciphertext     String
  iv             String
  authTag        String
  configuration  Json?
  keyVersion     Int                @default(1)
  lastFour       String
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, label])
  @@index([organizationId, isActive])
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  offer          String
  locations      String[]
  industries     String[]
  businessSize   String?
  discoverySources String[]     @default(["GOOGLE_PLACES", "WEB"])
  discoveryReport Json?
  targetCount    Int            @default(25)
  status         CampaignStatus @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    leads          Lead[]
    apifyRuns      ApifyDiscoveryRun[]

  @@index([organizationId, status, createdAt])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  category       String?
  imageUrls      String[]     @default([])
  analysis       Json?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, status, createdAt])
}

model ApifyDiscoveryRun {
  id String @id
  campaignId String
  organizationId String
  source String
  runId String?
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Lead {
  id               String      @id @default(cuid())
  organizationId   String
  campaignId       String?
  name             String
  website          String?
  industry         String?
  location         String?
  source           String?
  status           LeadStatus  @default(DISCOVERED)
  score            Int         @default(0)
  estimatedValue   Decimal?    @db.Decimal(14, 2)
  currency         String      @default("KES")
  aiSummary        String?
  recommendedOffer String?
  rawSignals       Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign         Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  signals          LeadSignal[]
  contacts         Contact[]
  outreach         OutreachMessage[]

  @@unique([organizationId, website])
  @@index([organizationId, status, score])
  @@index([campaignId])
}

model LeadSignal {
  id         String   @id @default(cuid())
  leadId     String
  source     String
  type       String
  value      String
  confidence Float
  evidenceUrl String?
  observedAt DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, type])
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  leadId         String
  name           String?
  title          String?
  email          String?
  phone          String?
  whatsapp       String?
  isDecisionMaker Boolean     @default(false)
  source         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([leadId])
}

model Sequence {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps          SequenceStep[]
  outreach       OutreachMessage[]

  @@index([organizationId, isActive])
}

model SequenceStep {
  id          String          @id @default(cuid())
  sequenceId  String
  position    Int
  delayHours  Int             @default(0)
  channel     OutreachChannel
  subject     String?
  prompt      String
  sequence    Sequence        @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, position])
}

model OutreachMessage {
  id             String          @id @default(cuid())
  organizationId String
  leadId         String
  sequenceId     String?
  channel        OutreachChannel
  status         OutreachStatus  @default(DRAFT)
  recipient      String
  subject        String?
  body           String
  scheduledFor   DateTime?
  sentAt         DateTime?
  providerId     String?
  failureReason  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequence       Sequence?       @relation(fields: [sequenceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, scheduledFor])
  @@index([leadId, channel])
}

model AutopilotConfig {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  enabled           Boolean      @default(false)
  minimumScore      Int          @default(80)
  dailyLimit        Int          @default(50)
  workingDays       Int[]        @default([1, 2, 3, 4, 5])
  workdayStart      String       @default("08:00")
  workdayEnd        String       @default("18:00")
  timezone          String       @default("Africa/Nairobi")
  approvalMode      String       @default("HIGH_VALUE_ONLY")
  highValueThreshold Decimal?    @db.Decimal(14, 2)
  followUpDays      Int          @default(3)
  stopOnReply       Boolean      @default(true)
  stopOnMeeting     Boolean      @default(true)
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model FileObject {
  id             String       @id @default(cuid())
  organizationId String
  objectKey      String       @unique
  bucket         String
  filename       String
  contentType    String
  sizeBytes      BigInt
  checksum       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String?
  userId         String?
  action         AuditAction
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipHash         String?
  createdAt      DateTime     @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}
